#grep -i "shadow " "$OUTPUTDIR/smblist.out/ALL_COMBINED_RESULTS.txt"
#grep -i ntdis.dit "$OUTPUTDIR/smblist.out/ALL_COMBINED_RESULTS.txt"

#Search for quick wins
#First, dig for gpp passwords
echo "
Looking for passwords in GPPs" | tee -a "$LOGFILE"
"$NETEXEC" smb "$DOMAIN" -u "$USERNAME" -p "$PASSWORD" -M gpp_password | tee -a "$LOGFILE" | tee "$OUTPUTDIR/gppScan.out"
echo "
Looking for passwords in autologin" | tee -a "$LOGFILE"
"$NETEXEC" smb "$DOMAIN" -u "$USERNAME" -p "$PASSWORD" -M gpp_autologin | tee -a "$LOGFILE" | tee -a "$OUTPUTDIR/gppScan.out"

#Get MachineAccountQuota attribute
echo "
Get MachineAccountQuota attribute:" | tee -a "$LOGFILE"
"$NETEXEC" ldap "$DCIP" -u "$USERNAME" -p "$PASSWORD" -d "$DOMAIN" -M maq | tee -a "$LOGFILE" | tee -a "$OUTPUTDIR/maq.out"

#List ADCS servers
echo "
Get ADCS servers:" | tee -a "$LOGFILE"
"$NETEXEC" ldap "$DCIP" -u "$USERNAME" -p "$PASSWORD" -d "$DOMAIN" -M adcs | tee -a "$LOGFILE" | tee -a "$OUTPUTDIR/adcs.out"

exit 0
