[*] Looking for passwords in descriptions..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M get-desc-users --threads $NETEXECTHREADS" "$MODE" "nxc_get-desc-users.out"
