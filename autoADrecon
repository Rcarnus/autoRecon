	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --gmsa --threads $NETEXECTHREADS" "$MODE" "nxc_gmsa.out"

	#Search for quick wins
