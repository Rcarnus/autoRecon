[*] Identifying pre2k computers..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M pre2k --threads $NETEXECTHREADS" "$MODE" "nxc_pre2k.out"
