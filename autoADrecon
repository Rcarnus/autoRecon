	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M certipy-find --threads $NETEXECTHREADS" "$MODE" "nxc_certipy-find.out"
logger "
[*] Extracting the list of active-users..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M --active-users --threads $NETEXECTHREADS" "$MODE" "nxc_active-users.out"

	logger "
Now we suggest the following next steps (without socks proxy):
autoNetRecon $ADCOMPUTERFQDNS
	then
autoADrecon vuln -u '$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -i autoNetRecon-output-dir/hostsSMB.list"

	logger "
Also check for AD DNS write permissions with
(not sure of this):
krbrelayx/dnstool.py '$DOMAIN/$USERNAME:$PASSWORD@$DCIP' --dns-server $DCIP --check-write"
}

