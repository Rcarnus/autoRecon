		logger "[!] Warning: socks proxy mode activated, scans might be slow and unreliable" "red"
	fi

	#cut -d ' '-f 1 $REACHABLEHOSTS > $REACHABLEHOSTS
	# Scanning all hosts once
	#ADCOMPUTERIPS="$OUTPUTDIR/ldapdomaindump/domain_computers.ips"
	#logger "
	#[*] Scanning all discovered hosts to identify resolvable and reachable SMB hosts"
	# Let's assume
