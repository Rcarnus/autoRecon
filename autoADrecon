#!/bin/bash

VERBOSE=0
DATE=$(date +"%Y%m%d-%H-%M")
#TODO add option to override the OUTPUTDIR
OUTPUTDIR="$PWD/autoad_output"
LOGFILE="$OUTPUTDIR/_autoADRecon_${DATE}.log"
# Default netexec threads
NETEXECTHREADS=100

printred(){
        echo -e "\033[0;31m$1\033[0m"
}
printgreen(){
        echo -e "\033[0;32m$1\033[0m"
}
printyellow(){
        echo -e "\033[0;33m$1\033[0m"
}

# Impacket folder for kali linux:
IMPACKETSCRIPTS="/usr/share/doc/python3-impacket/examples"
NETEXEC="netexec"
SMBMAP="smbmap"
BLOODHOUND="$HOME/.local/bin/bloodhound-ce-python"
LDAPDOMAINDUMP="ldapdomaindump"
HOST="host"
PROXYCHAINS="proxychains"

MODE=audit

# Retired tools:
#DROPTHEMICSCANNER="/opt/outils/exploit/cve-2019-1040-scanner/scan.py"
#SMBCRUNCHDIR="/opt/outils/windows/SMBCrunch/"
#GODDI="/opt/outils/windows/goddi/goddi-linux-amd64"
#LDAPSCANNER="/opt/outils/windows/ldap-scanner/ldap-scanner.py" #retired

checkbinary(){
        BINARY="$1"
        MANDATORY="$2"
        FOUND=false
        #echo "Checking for $BINARY"
        if [ -x "$BINARY" ]; then
                #echo "binary found at specified path"
                FOUND=true
        fi
        if [ -x "$(which $BINARY)" ]; then
                #echo "$BINARY found in the path"
                FOUND=true
        fi
        if [ "$FOUND" == true ]; then
                logger "[+] Found: $BINARY" "green"
        fi
        if [ "$MANDATORY" != true ] && [ "$FOUND" == false ]; then
                logger "[-] Not found requirement: $BINARY" "red"
        fi
        if [ "$MANDATORY" == true ] && [ "$FOUND" == false ]; then
                logger "[-] Not found mandatory requirement: $BINARY" "red"
                exit 1
        fi
}

checkreqs(){
	checkbinary "$HOST"
	checkbinary "$IMPACKETSCRIPTS/GetADUsers.py"
	checkbinary "$NETEXEC" true
	checkbinary "$BLOODHOUND"
	checkbinary "$SMBMAP"
	checkbinary "$LDAPDOMAINDUMP" true
	checkbinary "$PROXYCHAINS"
}

printusage(){
	echo "USAGE:
	$0 USERNAME PASSWORD FULLDOMAIN_NAME SMBHOSTSFILE [DCIP]

	Do all possible recon on a windows AD with user valid creds
"
}

printscanhelp(){
	echo "
$0 scan
	scan		   		Perform an AD scan with valid user credentials and save the output

	-u <[domain\]user>  Username (and optionally domain) to use to authentication with the AD. Format: [domain\]username
	-p <password>   	Password of the user to authenticate with
	-d <target-domain>  (optional) Domain to extract info from
	-c <dcip>   		(optional) IP address of a Domain Controller
	-o <output-dir>  	(optional) Use the specified output directory instead of the automatically computed one
	-x               	(optional) Activate socks proxy mode and use proxychains. Configuration will be red from the sytem configuration
	-v              	Verbose mode
	-h              	Print this help
"
}

printvulnhelp(){
	echo "
$0 vuln
	vuln             	Perform a scan of hosts and check for common vulnerabilities and misconfigurations

	-u <[domain\]user>  Username (and optionally domain) to use to authentication with the AD. Format: [domain\]username
	-p <password>   	Password of the user to authenticate with
	-i <autoNetRconDir>	Valid path to a folder containing the autoNetRecon output.
	-c <dcip>   		(optional) IP address of a Domain Controller
	-o <output-dir>  	(optional) Use the specified output directory instead of the automatically computed one
	-v              	Verbose mode
	-h              	Print this help
"
}

printfullusage(){
	if [ "$MODE" == "scan" ]; then
		printscanhelp
		return
	elif [ "$MODE" == "vuln" ]; then
		printvulnhelp
		return
	fi
	echo "
$0 (audit|scan|vuln)
	audit         		Prints out commands that will be performed during the scan without executing them
	scan            	Perform an AD scan with valid user credentials and save the output
	vuln             	Perform a scan of hosts and check for common vulnerabilities and misconfigurations

	-u <[domain\]user>  Username (and optionally domain) to use to authentication with the AD. Format: [domain\]username
	-p <password>   	Password of the user to authenticate with
	-d <target-domain>  (optional) Domain to extract info from
	-c <dcip>   		(optional) IP address of a Domain Controller
	-i <autoNetRconDir>	(optional) Valid path to a folder containing the autoNetRecon output.
	-o <output-dir>  	(optional) Use the specified output directory instead of the automatically computed one
	-x               	(optional) Activate socks proxy mode and use proxychains. Configuration will be red from the sytem configuration
	-v              	Verbose mode
	-h              	Print this help

Pro tip: to resume a previous scan, use the same output directory with the -o option.
"
}

printOrExecute(){
	CMD="$1"
	MODE="$2"
	OUTPUTFILE="$3" # Optional argument. Does not contain the OUTPUTDIR
	# OUTPUTDIR as global variable
	# LOGFILE as global variable
	if [ "$MODE" == "audit" ]; then
		echo "[AUDIT] $CMD"
	else
		if [ "$VERBOSE" == 1 ]; then
			echo "[EXECUTING] $CMD"
		fi
		touch "$LOGFILE"
		echo "" >> "$LOGFILE"
		echo "[EXECUTING] $CMD" >> "$LOGFILE"
		if [ -f "$OUTPUTDIR/$OUTPUTFILE" ]; then
			logger "[*] Output file $OUTPUTDIR/$OUTPUTFILE already exists. Skipping execution." "yellow"
			return
		else # Output file does not exist, let's execute the command
			# Outputfile is non empty
			if [ ! "$OUTPUTFILE" == "" ]; then
				touch "$OUTPUTDIR/$OUTPUTFILE"
				if [ ! -d "$(dirname "$OUTPUTDIR/$OUTPUTFILE")" ]; then
					#logger "[*] Creating output directory for file $OUTPUTDIR/$OUTPUTFILE" "yellow"
					mkdir -p "$(dirname "$OUTPUTDIR/$OUTPUTFILE")" || exit
				fi
				CMD="$CMD | tee '$OUTPUTDIR/$OUTPUTFILE'"
			fi

			if [ "$VERBOSE" == 1 ]; then
				eval "$CMD" | tee -a "$LOGFILE"
			else
				eval "$CMD" 2>&1 >> "$LOGFILE"
			fi

			# TODO: Fix this. Result CMD, is only the result of tee. We need the result of the command itself
			if [ $? -ne 0 ]; then
				logger "[-] Command failed." "red"
			else
				logger "[*] Success." "green"
			fi
		fi
	fi
}

logger(){
	MESSAGE="$1"
	COLOR="$2"
	if [ "$COLOR" == "red" ]; then
		MESSAGE="\033[0;31m$MESSAGE\033[0m"
	elif [ "$COLOR" == "green" ]; then
		MESSAGE="\033[0;32m$MESSAGE\033[0m"
	elif [ "$COLOR" == "yellow" ]; then
		MESSAGE="\033[0;33m$MESSAGE\033[0m"
	fi
	if [ "$MODE" == "audit" ]; then
		echo -e "$MESSAGE"
	else
		if [ -f "$LOGFILE" ]; then
			echo -e "$MESSAGE" | tee -a "$LOGFILE"
		else
			echo -e "$MESSAGE"
		fi
	fi
}

isAccountValid(){
	DCIP="$1"
	USERNAME="$2"
	PASSWORD="$3"
	DOMAIN="$4"
	#printOrExecute "$SMBMAP -H '$DCIP' -u '$USERNAME' -p '$PASSWORD' -d '$DOMAIN' | grep 'Status: Authenticated'" "$MODE"
	# Let's do it now with netexec
	printOrExecute "$NETEXEC smb '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' --threads 1 | grep '[+]'" "$MODE"
	return $?
}

isValidArgument(){
	#Verify if argument is empty or begins with a '-' char
	argument="$1"
	if [ "$argument" == "" -o "${argument:0:1}" == "-" ]; then
		echo "Invalid argument value $1"
		return 1
	fi
	return 0
}

# Start of main:
checkreqs

# Identify mode
if [ "$1" == "audit" ]; then
	MODE="audit"
	printyellow "
[*] Audit mode selected, no command will be executed
"
elif [ "$1" == "scan" ]; then
	MODE="scan"
	printyellow "
[*] Scan mode selected. Authenticated recon will be performed
"
elif [ "$1" == "vuln" ]; then
	MODE="vuln"
	printyellow "
[*] Vuln mode selected. Vulnerability scanning will be performed
"
else
	printred "First argument must be either 'audit', 'scan' or 'vuln'"
	printfullusage
	exit 1
fi

# Argument parsing
OPTIND=2         # Position ourselves after the first mandatory argument (mode)
# Initialize our own variables:
USERNAME=""
PASSWORD=""
DOMAIN=""
TARGETDOMAIN=""
AUTORECONDIR=""
DCIP=""
SOCKS=0
while getopts ":h?vxo:u:p:d:i:c:" opt; do
	case "$opt" in
		h)  printfullusage
			exit 1
			;;
		v)  VERBOSE=1
			echo "Verbose mode activated"
			;;
		x)  SOCKS=1
			echo "Socks proxy mode activated
			Using proxychains for all network commands"
			checkbinary "$PROXYCHAINS" true
			;;
		u)  USERNAME="${OPTARG}"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -u requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			;;
		p)  PASSWORD="$OPTARG"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -p requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			;;
		d)  TARGETDOMAIN="$OPTARG"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -d requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			;;
		i)  AUTORECONDIR="$OPTARG"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -i requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			;;
		o)  OUTPUTDIR="$OPTARG"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -o requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			OUTPUTDIR="$PWD/$OUTPUTDIR"
			LOGFILE="$OUTPUTDIR/_autoADRecon_${DATE}.log"
			;;
		c)  DCIP="$OPTARG"
			if [[ "${OPTARG}" == -* ]]; then
				echo "Option -c requires a valid argument. Got: ${OPTARG}"
				printfullusage
				exit 1
			fi
			;;
		:)  echo "Option -${OPTARG} requires an argument."
			exit 1
			;;
		?)  echo "Unrecognised Option: -${OPTARG}"
			exit 1
			;;
	esac
done

if [ "$VERBOSE" == 1 ]; then
	echo ""
	echo "Parameters:"
	echo "\$USERNAME=$USERNAME"
	echo "\$PASSWORD=$PASSWORD"
	echo "\$DOMAIN=$DOMAIN"
	echo "\$TARGETDOMAIN=$TARGETDOMAIN"
	echo "\$AUTORECONDIR=$AUTORECONDIR"
	echo "\$DCIP=$DCIP"
	echo "\$SOCKS=$SOCKS"
	echo ""
fi

shift $((OPTIND-1))
[ "${1:-}" = "--" ] && shift

# Outputdir will only be created after all checks are done
# Don't use logger in the meantime

if [ "$USERNAME" = "" -o "$PASSWORD" == "" ]; then
	echo "Missing at least one mandatory argument:"
	echo "		Username, Password"
	echo ""
	printfullusage
	exit 1
fi
if [ "$TARGETDOMAIN" == "" -a "$DCIP" == "" ]; then
	echo "Neither target-domain nor DCIP provided:"
	echo "		Please provide at least one of them."
	echo ""
	printfullusage
	exit 1
fi
# Argument parsing done

# Parse the username to extract domain if provided in format domain\username
if [[ "$USERNAME" == *"\\"* ]]; then
	DOMAIN="${USERNAME%%\\*}"
	USERNAME="${USERNAME##*\\}"
	printgreen "Extracted domain $DOMAIN from username, continue?"
fi

# Determine missing parameters
if [ "$DCIP" == "" ]; then
	echo "DC IP not provided, attempting to find it automatically"
	#if not provided determine automatically the DC IP
	DCIP=$(host "$TARGETDOMAIN" | grep "has address" | cut -d ' ' -f 4 | head -1)
	if [ "$DCIP" == "" ]; then
		printred "Can't find the DC automatically, please provide it"
		exit 1
	fi
	printgreen "Found $DCIP as DCIP, continue?"
fi
if [ "$TARGETDOMAIN" == "" ]; then
	echo "Domain not provided attempting to find it automatically"
	#if not provided determine automatically the Domain by connecting to the DC provided
	TARGETDOMAIN="$($NETEXEC smb $DCIP)" | grep domain: | cut -d '(' -f 3 | cut -d : -f 2 | sed 's/)//'
	if [ "$TARGETDOMAIN" == "" ]; then
		printred "Can't find the Domain automatically, please provide it"
		exit 1
	fi
	printgreen "Found $TARGETDOMAIN as target-domain, continue?"
fi

if [ "$DOMAIN" == "" ]; then
	DOMAIN="$TARGETDOMAIN"
	printgreen "[*] Using $DOMAIN as domain for authentication"
fi

#TODO: -vv could reactivate the proxychains debug
if [ "$SOCKS" == 1 ]; then
	NETEXEC="proxychains -q $NETEXEC"
	SMBMAP="proxychains -q $SMBMAP"
	IMPACKETSCRIPTS="proxychains -q $IMPACKETSCRIPTS"
	LDAPDOMAINDUMP="proxychains -q $LDAPDOMAINDUMP"
	BLOODHOUND="proxychains -q $BLOODHOUND"
	HOST="proxychains -q $HOST -T"
	# Reduce threads in socks mode
	# Too many threads will lead to timeouts and errors.
	# Reduce if working through HTTP tunnel (sliver c2, etc.)
	NETEXECTHREADS=10
	# TODO: measure the response time to adjust the timeout value accordingly
fi

# Test that the account is valid
logger "
[*] Checking if provided credentials are valid on $DCIP for domain $TARGETDOMAIN with user $USERNAME:" "yellow"
if [ "$MODE" == "audit" ]; then
	echo "	Not verifying credentials in audit mode"
else
	if ! isAccountValid "$DCIP" "$USERNAME" "$PASSWORD" "$DOMAIN"; then
		echo "	Can't connect with supplied credentials ($USERNAME) to $DCIP ($TARGETDOMAIN)"
	exit 1
	fi
fi

# Dont use logger before this point
# Create output directory and log file
if [ "$MODE" != "audit" ]; then
	if [ -d "$OUTPUTDIR" ]; then
		echo "Output directory $OUTPUTDIR already exists. Do you wish to resume execution of the previous one ? [N/y]"
		read answer
		if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
			echo "Exiting as requested"
			exit 1
		fi
	else
		echo "[*] Creating output directory $OUTPUTDIR"
		mkdir "$OUTPUTDIR" || exit
		# Only now we can call logger
	fi
fi

logger "[*] Log file: $LOGFILE"

# List domain Controllers again
logger "
[*] Identifying domain controllers in the domain $TARGETDOMAIN..." "yellow"
printOrExecute "$NETEXEC ldap $DCIP -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --dc-list --dns-tcp --dns-server $DCIP" "$MODE" "nxc_dc-list.out"
cat "$OUTPUTDIR/nxc_dc-list.out" | grep -v '[*]' | grep -v '[+]' | cut -d '=' -f 2 | cut -d ' ' -f 2 > "$OUTPUTDIR/_dclist.list"
#printOrExecute "$HOST '$TARGETDOMAIN' | grep 'has address' | cut -d ' ' -f 4 | tee '$OUTPUTDIR/domainControllers.list'" "$MODE"

scan(){
	# Bloodhound Extract
	logger "
[*] Fetching Bloodhound data from the AD..." "yellow"
	printOrExecute "mkdir '$OUTPUTDIR/bloodhound' || exit" "$MODE"
	printOrExecute "cd '$OUTPUTDIR/bloodhound' || exit" "$MODE"
	printOrExecute "$BLOODHOUND -u '$USERNAME@$DOMAIN' -p '$PASSWORD' -d '$TARGETDOMAIN' -c All,LoggedOn --zip --dns-tcp -ns $DCIP " "$MODE" "bloodhound.log"
	#Alternative with netexec:
	#printOrExecute "$NETEXEC ldap $DCIP -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' --bloodhound -c All,LoggedOn --dns-tcp --dns-server $DCIP --threads $NETEXECTHREADS --zip | tee -a '$OUTPUTDIR/bloodhound-extract.out'" "$MODE"
