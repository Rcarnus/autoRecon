	logger "
[*] Getting MachineAccountQuota attribute..." "yellow" 
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M maq --threads $NETEXECTHREADS" "$MODE" "nxc_maq.out"

	# Extract subnets
	logger "
[*] Extracting subnets..." "yellow"
	printOrExecute "$NETEXEC ldap '$DCIP' -u '$DOMAIN\\$USERNAME' -p '$PASSWORD' -d '$TARGETDOMAIN' -M get-network --threads $NETEXECTHREADS" "$MODE" "nxc_subnets.out"
